# ============================================
# hereOffer 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================

# ============================================
# 数据库配置
# ============================================
# MySQL 连接字符串
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名
# Docker Compose 环境: mysql+pymysql://recruit_user:recruit_password@mysql:3306/recruit_flow
# 本地开发环境: mysql+pymysql://user:password@localhost:3306/hereoffer
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/hereoffer

# ============================================
# Redis 配置
# ============================================
# Redis 连接字符串
# Docker Compose 环境: redis://redis:6379/0
# 本地开发环境: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT 认证配置
# ============================================
# JWT 签名密钥（生产环境请务必修改为强随机字符串）
# 生成方式: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
# JWT 算法
ALGORITHM=HS256
# Token 过期时间（分钟），默认 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# 大语言模型 (LLM) 配置
# ============================================
# 阿里云 DashScope API 密钥
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here
# LLM 请求超时时间（秒）
LLM_TIMEOUT_S=60
# 是否使用 Mock 模式（1=开启Mock，0=使用真实API）
# 开发测试时可设置为 1，生产环境必须设置为 0
LLM_MOCK=1

# ============================================
# MinIO 对象存储配置
# ============================================
# MinIO 服务地址
# Docker Compose 环境: minio:9000
# 本地开发环境: localhost:9000
MINIO_ENDPOINT=localhost:9000
# MinIO 访问密钥
MINIO_ACCESS_KEY=minioadmin
# MinIO 秘密密钥
MINIO_SECRET_KEY=minioadmin
# 默认存储桶名称
MINIO_BUCKET=hereoffer
# 是否使用 SSL 连接（true/false）
MINIO_USE_SSL=false

# ============================================
# Milvus 向量数据库配置（RAG 功能需要）
# ============================================
# Milvus 服务地址
# Docker Compose 环境: milvus
# 本地开发环境: localhost
MILVUS_HOST=localhost
# Milvus 端口
MILVUS_PORT=19530
# Collection 名称
MILVUS_COLLECTION_NAME=hereoffer_kb
# 嵌入向量维度（bge-base-zh-v1.5 模型为 768）
EMBEDDING_DIM=768
# 嵌入模型名称
EMBEDDING_MODEL=bge-base-zh-v1.5

# ============================================
# 应用配置
# ============================================
# 调试模式（true/false）
# 生产环境请设置为 false
DEBUG=True
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=DEBUG

# ============================================
# 语音服务配置（可选，当前功能已禁用）
# ============================================
# 阿里云 ASR (语音识别) AppKey
ALIYUN_ASR_APPKEY=
# 阿里云 ASR Token
ALIYUN_ASR_TOKEN=
# 阿里云 TTS (语音合成) AppKey
ALIYUN_TTS_APPKEY=
# 阿里云 TTS Token
ALIYUN_TTS_TOKEN=
# 语音服务 Mock 模式（1=开启Mock，0=使用真实API）
VOICE_MOCK=1